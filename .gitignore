node_modules/
.env

# Runtime data files -- created fresh on first run (or seeded onto the
# Railway Volume by migrateDataFile), never committed. Mirrors chat-app's
# discipline of git-adding specific code files only, never these.
crm_*.json

# User-uploaded media (logos, attachments) -- same discipline as the data
# files above: real runtime content, not app code, belongs on a Railway
# Volume, not in git.
uploads/

# Per-contact/per-source message splits (message_index.js) -- same runtime
# data as crm_*.json above, just organized as one-file-per-key instead of
# one big file, so the crm_*.json glob doesn't already catch it.
msg_by_contact/
msg_by_source/

# This tool's own local session config, not app code.
.claude/
